local function ArrowVisualDuplicateSpawn(Origin, Direction)
    local Now = os.clock()
    local LastOrigin = ArrowVisualRuntime.LastSpawnOrigin
    local LastDirection = ArrowVisualRuntime.LastSpawnDirection
    local Duplicate = false
    if Now - ArrowVisualRuntime.LastSpawnAt <= 0.14 and typeof(Origin) == "Vector3" and typeof(LastOrigin) == "Vector3" and (Origin - LastOrigin).Magnitude <= 0.75 then
        if typeof(Direction) == "Vector3" and typeof(LastDirection) == "Vector3" and Direction.Magnitude > 0.001 and LastDirection.Magnitude > 0.001 then
            Duplicate = Direction.Unit:Dot(LastDirection.Unit) >= 0.998
        else
            Duplicate = true
        end
    end
    ArrowVisualRuntime.LastSpawnAt = Now
    ArrowVisualRuntime.LastSpawnOrigin = Origin
    ArrowVisualRuntime.LastSpawnDirection = Direction
    return Duplicate
end

local function ArrowVisualTrackCast(Cast, Origin, Direction)
    if ArrowVisualDuplicateSpawn(Origin, Direction) then
        return
    end
    local Object = nil
    pcall(function()
        Object = Cast and Cast.RayInfo and Cast.RayInfo.CosmeticBulletObject
    end)
    if Object then
        ArrowVisualTrack(Object, Origin)
        return
    end
    task.defer(function()
        for _ = 1, 6 do
            pcall(function()
                Object = Cast and Cast.RayInfo and Cast.RayInfo.CosmeticBulletObject
            end)
            if Object then
                ArrowVisualTrack(Object, Origin)
                return
            end
            task.wait()
        end
    end)
end

