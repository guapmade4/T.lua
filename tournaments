    local function SwordHitBindCharacter(Character)
        local State = ArrowVisualRuntime.Melee
        if State.Connection then
            State.Connection:Disconnect()
            State.Connection = nil
        end
        State.Character = Character
        State.AttackEndedAt = -math.huge
        State.AttackWeapon = "none"
        State.AttackActive = false
        State.LastHits = setmetatable({}, {__mode = "k"})
        if not Character then
            return
        end
        local function OnAttackChanged()
            if Character ~= AutoParryLocalPlayer.Character then
                return
            end
            if Character:GetAttribute("Attacking") == true then
                State.AttackActive = true
                State.AttackWeapon = AutoParryWeaponName(AutoParryLocalPlayer, Character)
            elseif State.AttackActive then
                State.AttackActive = false
                State.AttackEndedAt = os.clock()
            end
        end
        State.Connection = Character:GetAttributeChangedSignal("Attacking"):Connect(OnAttackChanged)
        table.insert(ArrowVisualRuntime.Connections, State.Connection)
        OnAttackChanged()
    end

    local function SwordHitOnDamage(Action, _, Damage, HitPart)
        if Action ~= "Damageindicator" or ArrowVisualFlag("ArrowHitEffectsEnabled", false) ~= true then
            return
        end
        if not tonumber(Damage) or tonumber(Damage) <= 0 or typeof(HitPart) ~= "Instance" or not HitPart:IsA("BasePart") or not HitPart.Parent then
            return
        end
        local Character = AutoParryLocalPlayer and AutoParryLocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        if not Character or not Character.Parent or not Humanoid or Humanoid.Health <= 0 or not Root or Character:GetAttribute("Sheathed") ~= false then
            return
        end
        local WeaponName = AutoParryWeaponName(AutoParryLocalPlayer, Character)
        local Stats = AutoParryGetStats(WeaponName)
        if not AutoParrySupported(Stats) then
            return
        end
        local State = ArrowVisualRuntime.Melee
        local Now = os.clock()
        if Character:GetAttribute("Attacking") ~= true and not (State.Character == Character and State.AttackWeapon == WeaponName and Now - State.AttackEndedAt <= 0.25) then
            return
        end
        local Target = ArrowVisualFindCharacterFromPart(HitPart)
        if not Target or Target == Character or not Target.Parent then
            return
        end
        local Reach = math.max(AutoParryReach(Stats, "M1"), AutoParryReach(Stats, "Heavy")) + 2
        if (HitPart.Position - Root.Position).Magnitude > Reach then
            return
        end
        local LastHit = State.LastHits[Target]
        if LastHit and Now - LastHit < 0.06 then
            return
        end
        State.LastHits[Target] = Now
        State.HitEvents += 1
        State.LastWeapon = WeaponName
        ArrowVisualRuntime.LastImpactTarget = Target.Name
        ArrowVisualApplyHitEffects(Target, HitPart.Position)
    end

    local function SwordHitConnect()
        if not AutoParryLocalPlayer then
            return
        end
        SwordHitBindCharacter(AutoParryLocalPlayer.Character)
        table.insert(ArrowVisualRuntime.Connections, AutoParryLocalPlayer.CharacterAdded:Connect(SwordHitBindCharacter))
        local Events = AutoParryReplicatedStorage:FindFirstChild("Events")
        local VFX = Events and Events:FindFirstChild("VFX")
        if VFX and VFX:IsA("RemoteEvent") then
            table.insert(ArrowVisualRuntime.Connections, VFX.OnClientEvent:Connect(SwordHitOnDamage))
            ArrowVisualRuntime.Melee.Hooked = true
        end
    end

    SwordHitConnect()
end

