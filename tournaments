local function AutoParryFlag(Name)
    local Control = Library.Flags and Library.Flags[Name]
    if not Control or type(Control.Get) ~= "function" then
        return nil
    end
    local Success, Value = pcall(function()
        return Control:Get()
    end)
    if Success then
        return Value
    end
    return nil
end

local function AutoParryWeaponName(Player, Character)
    local Name = nil
    if Player then
        pcall(function()
            local Data = Player:FindFirstChild("Data")
            local Values = Data and Data:FindFirstChild("PlayerValues")
            local Weapon = Values and Values:FindFirstChild("weapon")
            if Weapon then
                Name = tostring(Weapon.Value)
            end
        end)
    end
    if (not Name or Name == "" or Name == "None") and Character then
        pcall(function()
            local Value = Character:GetAttribute("CurrentWeapon")
            if Value ~= nil then
                Name = tostring(Value)
            end
        end)
    end
    if not Name or Name == "" then
        Name = "Sword"
    end
    return Name
end

local function AutoParryGetStats(Name)
    if type(AutoParryWeaponStats) ~= "table" or type(AutoParryWeaponStats.getStats) ~= "function" then
        return nil
    end
    local Success, Value = pcall(AutoParryWeaponStats.getStats, Name)
    if Success and type(Value) == "table" then
        AutoParryRuntime.StatsQueryError = "none"
        return Value
    end
    AutoParryRuntime.StatsQueryError = tostring(Success and "Invalid weapon stats" or Value):sub(1, 500)
    return nil
end

local function AutoParrySupported(Stats)
    if type(Stats) ~= "table" then
        return false
    end
    if Stats.Ranged == true or Stats.Type == "Bow" or Stats.Type == "Shield" or Stats.Type == "Banner" then
        return false
    end
    return Stats.Animations ~= nil and Stats.SwingSpeed ~= nil
end

local function AutoParryPing()
    local Value = 0
    local Success = pcall(function()
        local Item = AutoParryStatsService.Network.ServerStatsItem["Data Ping"]
        Value = tonumber(Item:GetValue()) or 0
    end)
    AutoParryRuntime.PingMs = math.max(0, Value)
    AutoParryRuntime.PingAvailable = Success
    Value = math.clamp(Value / 2000, 0, 0.18)
    AutoParryRuntime.LastPing = Value
    return Value
end

local function AutoParryAccuracy()
    local Chance = tonumber(AutoParryFlag("AutoParryAccuracy")) or 100
    if AutoParryFlag("RandomizeAccuracy") == true then
        local Value = AutoParryFlag("AccuracyRange")
        local Min = 80
        local Max = 100
        if type(Value) == "table" then
            Min = tonumber(Value.Min or Value.min or Value[1]) or Min
            Max = tonumber(Value.Max or Value.max or Value[2]) or Max
        end
        if Min > Max then
            Min, Max = Max, Min
        end
        Chance = Min + math.random() * (Max - Min)
    end
    return math.random() * 100 <= math.clamp(Chance, 0, 100)
end

local function AutoParryClassifyAnimation(Stats, Track)
    if not Track or type(Stats) ~= "table" then
        return nil, "Unknown"
    end
    local function AssetId(Value)
        local Id = tostring(Value or "")
        return Id:match("^rbxassetid://(%d+)$") or Id:match("[?&]id=(%d+)") or Id:match("^%d+$") or Id
    end
    local function NameKind(Name, ParentName)
        local Lower = string.lower(Name or "")
        local Parent = string.lower(ParentName or "")
        -- Reactions containing 'heavy' are not heavy attacks.
        if Parent == "hit" or Lower == "heavyhit" or Lower == "victim" or Lower:find("parried", 1, true) then
            return nil
        end
        if Lower:find("runswing", 1, true) or Lower:find("run swing", 1, true) then return "RunSwing" end
        if Lower:find("heavy", 1, true) or Parent:find("heavy", 1, true) then return "Heavy" end
        if Lower:find("critical", 1, true) or Lower:find("crit", 1, true) or Parent:find("critical", 1, true) then return "Critical" end
        if Lower:find("swing", 1, true) or Parent == "attack" then return "M1" end
        return nil
    end
    local Animation = Track.Animation
    local AnimationId = AssetId(Animation and Animation.AnimationId)
    local Sets, SeenSets = {}, {}
    for _, Field in ipairs({"Animations", "Critical", "HeavySwings"}) do
        local Value = Stats[Field]
        if type(Value) == "string" and Value ~= "" and not SeenSets[Value] then
            SeenSets[Value] = true
            Sets[#Sets + 1] = Value
        end
    end
    if not SeenSets.General then Sets[#Sets + 1] = "General" end
    local KnownNoncombat = false
    if AutoParryWeapons and AnimationId ~= "" then
        for _, SetName in ipairs(Sets) do
            local Shared = SetName == "General"
            local Set = Shared and AutoParryWeapons.Parent and AutoParryWeapons.Parent:FindFirstChild(SetName)
                or AutoParryWeapons:FindFirstChild(SetName)
            if Set then
                AutoParryRuntime.AnimationIndexes = AutoParryRuntime.AnimationIndexes or setmetatable({}, {__mode = "k"})
                local Index = AutoParryRuntime.AnimationIndexes[Set]
                if not Index then
                    Index = {Dirty = true, Kinds = {}, Watchers = {}}
                    local Cleanup = {}
                    function Cleanup:Disconnect()
                        for _, Connection in ipairs(Index.Watchers) do Connection:Disconnect() end
                        Index.Watchers = {}
                    end
                    AutoParryRuntime.Connections[#AutoParryRuntime.Connections + 1] = Cleanup
                    AutoParryRuntime.AnimationIndexes[Set] = Index
                    for _, Signal in ipairs({Set.DescendantAdded, Set.DescendantRemoving}) do
                        AutoParryRuntime.Connections[#AutoParryRuntime.Connections + 1] = Signal:Connect(function()
                            Index.Dirty = true
                        end)
                    end
                end
                if Index.Dirty then
                    for _, Connection in ipairs(Index.Watchers) do Connection:Disconnect() end
                    Index.Watchers = {}
                    local Kinds = {}
                    for _, Object in ipairs(Set:GetDescendants()) do
                        -- Folder renames can also change the attack category.
                        local Connection = Object.Changed:Connect(function(Property)
                            if Property == "Name" or Property == "AnimationId" or Property == "Parent" then Index.Dirty = true end
                        end)
                        Index.Watchers[#Index.Watchers + 1] = Connection
                        if Object:IsA("Animation") then
                            local Id = AssetId(Object.AnimationId)
                            local ParentName = Object.Parent and Object.Parent.Name or ""
                            local Kind = nil
                            if not Shared then Kind = NameKind(Object.Name, ParentName) end
                            local Parent = string.lower(ParentName)
                            local Lower = string.lower(Object.Name)
                            local Noncombat
                            if Shared then
                                Noncombat = Parent == "hit" or Parent == "resting" or Lower == "standup" or Lower == "getup"
                                    or Lower == "burnanimation" or Lower == "sprint" or Lower == "shieldblocking" or Lower == "shieldparry"
                            else
                                Noncombat = Lower == "victim" or Parent == "main" or Parent == "blocking" or Parent == "flinch" or Parent == "parryanims" or Parent == "execution"
                            end
                            if Id ~= "" then
                                if Kind then Kinds[Id] = Kind
                                elseif Noncombat and Kinds[Id] == nil then Kinds[Id] = false end
                            end
                        end
                    end
                    Index.Kinds = Kinds
                    Index.Dirty = false
                    AutoParryRuntime.AnimationIndexBuilds = (AutoParryRuntime.AnimationIndexBuilds or 0) + 1
                end
                local Kind = Index.Kinds[AnimationId]
                if Kind then return Kind end
                if Kind == false then KnownNoncombat = true end
            end
        end
    end
    -- Asset matches take precedence over generic or misleading track names.
    if KnownNoncombat then return nil, "Noncombat" end
    local Name = tostring((Animation and Animation.Name) or Track.Name or "")
    local Kind = NameKind(Name, "")
    if Kind then return Kind end
    local Lower = string.lower(Name)
    if Lower:find("attack", 1, true) then return "M1" end
    return nil, "Unknown"
end

local function AutoParryAttackSpeed(Stats, Kind, Track)
    local Speed = 1
    if Kind == "Heavy" then
        Speed = tonumber(Stats.HeavyAnimationSpeed) or tonumber(Stats.SwingSpeed) or 1
    elseif Kind == "Critical" then
        Speed = tonumber(Stats.CriticalAnimationSpeed) or 1
    else
        Speed = tonumber(Stats.SwingSpeed) or 1
    end
    pcall(function()
        if tonumber(Track.Speed) and Track.Speed > 0.01 then
            Speed = Track.Speed
        end
    end)
    return math.max(0.05, Speed)
end

local function AutoParryReach(Stats, Kind)
    local Size = Stats.M1HitboxSize
    local Offset = Stats.M1Offset
    if Kind == "Heavy" and typeof(Stats.M2HitboxSize) == "Vector3" then
        Size = Stats.M2HitboxSize
    end
    if Kind == "Heavy" and typeof(Stats.M2Offset) == "CFrame" then
        Offset = Stats.M2Offset
    end
    local Reach = 7
    if typeof(Size) == "Vector3" then
        Reach = math.max(Reach, Size.Z * 0.5)
    end
    if typeof(Offset) == "CFrame" then
        Reach = math.max(Reach, math.abs(Offset.Position.Z) + (typeof(Size) == "Vector3" and Size.Z * 0.5 or 0))
    end
    if Stats.Type == "Heavy" then
        Reach += 0.75
    end
    return Reach
end

local function AutoParryImpactKeyTime(Stats, Kind, Track)
    local Speed = AutoParryAttackSpeed(Stats, Kind, Track)
    local Length = 0
    pcall(function() Length = tonumber(Track.Length) or 0 end)
    local Animation = Track and Track.Animation
    local RawId = tostring(Animation and Animation.AnimationId or "")
    local Id = RawId:match("^rbxassetid://(%d+)$") or RawId:match("[?&]id=(%d+)") or RawId:match("^%d+$")
    AutoParryRuntime.ImpactMetadata = AutoParryRuntime.ImpactMetadata or {}
    local Entry = Id and AutoParryRuntime.ImpactMetadata[Id]
    if not Entry and Id then
        Entry = {Loading = false, Tried = false, RetryAt = 0, NamedTried = false}
        AutoParryRuntime.ImpactMetadata[Id] = Entry
    end
    local HitNames = {Hit = true, Hit1 = true, HitStart = true, Damage = true, DamageStart = true}
    if Entry and not Entry.NamedTried and Length > 0.05 then
        Entry.NamedTried = true
        for Name in pairs(HitNames) do
            local Success, Time = pcall(function() return Track:GetTimeOfKeyframe(Name) end)
            if Success and type(Time) == "number" and Time > 0 and Time <= Length and (not Entry.Time or Time < Entry.Time) then
                Entry.Time = Time
                Entry.Source = "Named hit keyframe"
            end
        end
    end
    if Entry and not Entry.Loading and not Entry.Time and (not Entry.Tried or os.clock() >= Entry.RetryAt) and (AutoParryRuntime.TimingWorkers or 0) < 2 then
        Entry.Loading = true
        Entry.Status = "Loading animation metadata"
        Entry.Tried = true
        Entry.RetryAt = math.huge
        AutoParryRuntime.TimingWorkers = (AutoParryRuntime.TimingWorkers or 0) + 1
        AutoParryRuntime.TimingLoads = (AutoParryRuntime.TimingLoads or 0) + 1
        task.spawn(function()
            local Clip = nil
            local Success, Error = pcall(function()
                Clip = game:GetService("AnimationClipProvider"):GetAnimationClipAsync("rbxassetid://" .. Id)
                Entry.Clip = Clip
                Entry.ClipClass = tostring(Clip.ClassName or "unknown")
                AutoParryRuntime.LastTimingClipClass = Entry.ClipClass
                local MarkerNames = {}
                if Clip:IsA("CurveAnimation") then
                    AutoParryRuntime.TimingCurveClips = (AutoParryRuntime.TimingCurveClips or 0) + 1
                    for _, Curve in ipairs(Clip:GetDescendants()) do
                        if Curve:IsA("MarkerCurve") then
                            for _, Marker in ipairs(Curve:GetMarkers()) do
                                if type(Marker) == "table" then
                                    local Time = tonumber(Marker.Time or Marker.time)
                                    local Name = Marker.Name or Marker.name or Marker.Value or Marker.value
                                    if HitNames[Curve.Name] then Name = Curve.Name end
                                    if type(Name) == "string" then
                                        MarkerNames[Name] = true
                                        if HitNames[Name] and Time and Time == Time and Time > 0 and Time < math.huge
                                            and (not Entry.Time or Time < Entry.Time) then
                                            Entry.Time = Time
                                            Entry.Source = "Curve animation hit marker"
                                        end
                                    end
                                end
                            end
                        end
                    end
                elseif Clip:IsA("KeyframeSequence") then
                for _, Frame in ipairs(Clip:GetKeyframes()) do
                    local Time = tonumber(Frame.Time) or 0
                    local Hit = HitNames[Frame.Name] == true
                    for _, Marker in ipairs(Frame:GetMarkers()) do
                        MarkerNames[Marker.Name] = true
                        if HitNames[Marker.Name] then Hit = true end
                    end
                    if Hit and Time > 0 and (not Entry.Time or Time < Entry.Time) then
                        Entry.Time = Time
                        Entry.Source = "Animation hit marker"
                    end
                end
                else
                    Entry.Status = "Unsupported animation clip type: " .. Entry.ClipClass
                    AutoParryRuntime.TimingUnsupportedClips = (AutoParryRuntime.TimingUnsupportedClips or 0) + 1
                    return
                end
                local Names = {}
                for Name in pairs(MarkerNames) do Names[#Names + 1] = Name end
                table.sort(Names)
                Entry.Markers = table.concat(Names, ", ")
                AutoParryRuntime.LastTimingMarkers = Entry.Markers ~= "" and Entry.Markers or "none"
                if not Entry.Time then
                    Entry.Status = "No recognized hit keyframe or marker"
                    AutoParryRuntime.TimingMissingMarkers = (AutoParryRuntime.TimingMissingMarkers or 0) + 1
                else
                    Entry.Status = Entry.Source
                end
            end)
            Entry.Loading = false
            AutoParryRuntime.TimingWorkers = math.max(0, (AutoParryRuntime.TimingWorkers or 1) - 1)
            if not Success then
                Entry.Status = "Metadata load failed; retry in 60 seconds"
                Entry.RetryAt = os.clock() + 60
                AutoParryRuntime.TimingErrors = (AutoParryRuntime.TimingErrors or 0) + 1
                AutoParryRuntime.LastTimingError = tostring(Error):sub(1, 240)
            end
        end)
    end
    if Entry and Entry.Time then
        AutoParryRuntime.LastTimingFallbackReason = "none"
        return Entry.Time, Speed, Entry.Source
    end
    AutoParryRuntime.LastTimingFallbackReason = Entry and (Entry.Status or "Waiting for metadata worker") or "Animation asset ID unavailable"
    local Fraction = 0.42
    local Fallback = 0.30
    if Kind == "Heavy" then
        Fraction = 0.48
        Fallback = 0.43
    elseif Kind == "Critical" then
        Fraction = 0.46
        Fallback = 0.39
    elseif Kind == "RunSwing" then
        Fraction = 0.38
        Fallback = 0.27
    end
    if Length > 0.05 then
        return Length * Fraction, Speed, "Length fraction"
    end
    return Fallback * Speed, Speed, "Unloaded animation fallback"
end

local function AutoDodgePoll()
    local State = AutoParryRuntime.Dodge
    local Character = AutoParryLocalPlayer and AutoParryLocalPlayer.Character
    local Now = os.clock()
    if State.Character ~= Character then
        State.Character = Character
        State.WasDashing = false
        State.ReadyAt = 0
        State.LastRequestAt = 0
        State.Pending = nil
    end
    local Dashing = Character and Character:GetAttribute("Dashing") == true or false
    if Dashing and not State.WasDashing then
        local Scripts = AutoParryLocalPlayer and AutoParryLocalPlayer.FindFirstChild and AutoParryLocalPlayer:FindFirstChild("PlayerScripts")
        local Systems = Scripts and Scripts:FindFirstChild("Systems")
        State.NativeCooldown = Systems and Systems:FindFirstChild("TrocaServidor") and 1.5 or 2
        State.ReadyAt = math.max(State.ReadyAt, Now + State.NativeCooldown)
    end
    State.WasDashing = Dashing
    local Pending = State.Pending
    if Pending then
        if Pending.Character == Character and Dashing then
            State.Dodges += 1
            State.LastAttacker = Pending.Threat.Player and Pending.Threat.Player.Name or Pending.Threat.Character.Name
            Pending.Threat.Resolved = true
            State.Pending = nil
            State.LastSkip = "none"
            if AutoParryRuntime.Note then AutoParryRuntime.Note("Dodge started", State.LastAttacker) end
        elseif Pending.Character ~= Character or not Character or not Character.Parent or Now - Pending.CreatedAt >= 0.2 then
            State.Rejected += 1
            State.Pending = nil
            State.LastSkip = "Native dash did not start"
            if AutoParryRuntime.Note then AutoParryRuntime.Note("Dodge rejected", State.LastSkip) end
        end
    end
end

local function AutoDodgeReady()
    local State = AutoParryRuntime.Dodge
    local function Blocked(Reason)
        State.LastSkip = Reason
        return nil
    end
    if AutoParryFlag("DodgeEnabled") ~= true then return Blocked("Disabled") end
    if State.Pending then return Blocked("Native dash pending") end
    local Character = State.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if not Character or not Character.Parent or not Humanoid or Humanoid.Health <= 0 or not Root then
        return Blocked("Local character unavailable")
    end
    if Humanoid.SeatPart then return Blocked("Local seated") end
    for _, Name in ipairs({"Stunned", "IsRagdoll", "Attacking", "Blocking", "Dashing", "Disabled", "Emoting", "DSL"}) do
        if Character:GetAttribute(Name) == true then return Blocked("Local " .. Name) end
    end
    local Now = os.clock()
    if Now < State.ReadyAt or Now - State.LastRequestAt < 0.25 then return Blocked("Dash cooldown") end
    local Mechanics = Character:FindFirstChild("Mechanics")
    local Client = Mechanics and Mechanics:FindFirstChild("Client")
    local Action = Client and Client:FindFirstChild("MobileAction") or Character:FindFirstChild("MobileAction", true)
    if not Action or not Action:IsA("BindableEvent") then return Blocked("Native dash action unavailable") end
    State.LastSkip = "Ready; awaiting incoming attack"
    return Character, Action
end

local function AutoDodgeFire(Threat)
    AutoDodgePoll()
    local State = AutoParryRuntime.Dodge
    if Threat.Resolved or Threat.DodgeAttempted then return false end
    local Character, Action = AutoDodgeReady()
    if not Character then return false end
    local Now = os.clock()
    Threat.DodgeAttempted = true
    State.LastRequestAt = Now
    State.Pending = {Character = Character, Threat = Threat, CreatedAt = Now}
    local Success, Error = pcall(function() Action:Fire("Dash") end)
    if not Success then
        State.FireErrors += 1
        State.Pending = nil
        State.LastFireError = tostring(Error):sub(1, 240)
        State.LastSkip = "Native dash error: " .. State.LastFireError
        if AutoParryRuntime.Note then AutoParryRuntime.Note("Dodge error", State.LastFireError) end
        return false
    end
    State.Requests += 1
    if AutoParryRuntime.Note then AutoParryRuntime.Note("Dodge requested", Threat.Player and Threat.Player.Name or Threat.Character.Name) end
    AutoDodgePoll()
    return Threat.Resolved == true
end

local function AutoParryLocalReady()
    local function Blocked(Reason)
        AutoParryRuntime.LastSkip = Reason
        return false
    end
    local Character = AutoParryLocalPlayer and AutoParryLocalPlayer.Character
    local WeaponName = AutoParryWeaponName(AutoParryLocalPlayer, Character)
    local Stats = AutoParryGetStats(WeaponName)
    AutoParryRuntime.LocalWeapon = Character and WeaponName or "none"
    AutoParryRuntime.LocalWeaponSupported = AutoParrySupported(Stats)
    if AutoParryFlag("AutoParry") ~= true then return Blocked("Disabled") end
    if AutoParryRuntime.Dodge.Pending then return Blocked("Native dash pending") end
    if not Character or not Character.Parent then return Blocked("Local character unavailable") end
    if not AutoParryRuntime.LocalWeaponSupported then return Blocked("Weapon stats unavailable or unsupported") end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if not Humanoid or Humanoid.Health <= 0 then return Blocked("Local character unavailable") end
    if Humanoid.SeatPart then return Blocked("Local seated") end
    if Character:GetAttribute("Sheathed") ~= false then return Blocked("Weapon sheathed") end
    for _, Name in ipairs({"Attacking", "Disabled", "Emoting", "Stunned", "IsRagdoll", "Dashing", "GuardLocked"}) do
        if Character:GetAttribute(Name) == true then return Blocked("Local " .. Name) end
    end
    if not AutoParryCombat then return Blocked("Combat remote unavailable") end
    if Character:GetAttribute("ParryCD") == true or os.clock() < AutoParryRuntime.ParryReadyAt then return Blocked("Parry cooldown") end
    AutoParryRuntime.LastSkip = "Ready; awaiting incoming attack"
    return true
end

AutoParryRuntime.SampleDiagnostics = function(DeltaTime)
    local Diagnostic = AutoParryRuntime.Diagnostics
    if DeltaTime then
        Diagnostic.HeartbeatPulses += 1
        Diagnostic.LastHeartbeatAt = os.clock()
        if DeltaTime > 0 then
            local FPS = 1 / DeltaTime
            Diagnostic.FPS = Diagnostic.FPS == 0 and FPS or Diagnostic.FPS * 0.9 + FPS * 0.1
        end
        if os.clock() < (Diagnostic.NextSampleAt or 0) then return end
    end
    Diagnostic.NextSampleAt = os.clock() + 0.25
    AutoParryRuntime.CombatAvailable = AutoParryCombat ~= nil
    AutoParryRuntime.StatsAvailable = type(AutoParryWeaponStats) == "table"
    AutoParryRuntime.AnimationsAvailable = AutoParryWeapons ~= nil
    AutoParryPing()
    AutoParryLocalReady()
    AutoDodgeReady()
    local Character = AutoParryLocalPlayer and AutoParryLocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local LocalRoot = Character and Character:FindFirstChild("HumanoidRootPart")
    Diagnostic.LocalHealth = Humanoid and Humanoid.Health or 0
    Diagnostic.LocalCharacter = Character and Character:GetFullName() or "unavailable"
    local Attributes = {}
    for _, Name in ipairs({"Sheathed", "Attacking", "Stunned", "IsRagdoll", "Blocking", "Dashing", "Disabled", "Emoting", "DSL", "ParryCD", "GuardLocked"}) do
        Attributes[#Attributes + 1] = Name .. "=" .. tostring(Character and Character:GetAttribute(Name))
    end
    Diagnostic.LocalAttributes = table.concat(Attributes, ", ")
    Diagnostic.EnemyPlayers = 0
    Diagnostic.EnemyCharacters = 0
    Diagnostic.EnemyHumanoids = 0
    Diagnostic.EnemyAnimators = 0
    Diagnostic.NearestEnemy = "none"
    Diagnostic.NearestEnemyDistance = 0
    local Nearest = math.huge
    for _, Player in ipairs(AutoParryPlayers:GetPlayers()) do
        if Player ~= AutoParryLocalPlayer then
            Diagnostic.EnemyPlayers += 1
            local Enemy = Player.Character
            if Enemy then
                Diagnostic.EnemyCharacters += 1
                local EnemyHumanoid = Enemy:FindFirstChildOfClass("Humanoid")
                if EnemyHumanoid then
                    Diagnostic.EnemyHumanoids += 1
                    if EnemyHumanoid:FindFirstChildOfClass("Animator") then Diagnostic.EnemyAnimators += 1 end
                end
                local Root = Enemy:FindFirstChild("HumanoidRootPart")
                if Root and LocalRoot then
                    local Distance = (Root.Position - LocalRoot.Position).Magnitude
                    if Distance < Nearest then
                        Nearest = Distance
                        Diagnostic.NearestEnemy = Player.Name
                        Diagnostic.NearestEnemyDistance = Distance
                        Diagnostic.NearestEnemyWeapon = AutoParryWeaponName(Player, Enemy)
                        Diagnostic.NearestEnemyAttacking = tostring(Enemy:GetAttribute("Attacking"))
                    end
                end
            end
        end
    end
end

local function AutoParryFire(Threat)
    if not AutoParryLocalReady() or not AutoParryCombat then
        return false
    end
    local Now = os.clock()
    if Now - AutoParryRuntime.LastParryAt < 0.12 or Now < AutoParryRuntime.ParryReadyAt then
        return false
    end
    local Success, Error = pcall(function()
        AutoParryCombat:FireServer("Parry")
    end)
    if not Success then
        AutoParryRuntime.FireErrors += 1
        AutoParryRuntime.LastFireError = tostring(Error):sub(1, 240)
        AutoParryRuntime.LastSkip = "Combat remote error: " .. AutoParryRuntime.LastFireError
        if AutoParryRuntime.Note then AutoParryRuntime.Note("Parry error", AutoParryRuntime.LastFireError) end
        return false
    end
    AutoParryRuntime.LastParryAt = Now
    AutoParryRuntime.ParryReadyAt = Now + 4
    AutoParryRuntime.Parries += 1
    AutoParryRuntime.LastAttacker = Threat.Player and Threat.Player.Name or Threat.Character.Name
    AutoParryRuntime.LastWeapon = Threat.WeaponName
    AutoParryRuntime.LastAttackType = Threat.Kind
    AutoParryRuntime.LastTimingSource = Threat.TimingSource or "unavailable"
    AutoParryRuntime.LastImpactKeyTime = Threat.ImpactKeyTime
    AutoParryRuntime.LastTrackSpeed = Threat.Speed
    AutoParryRuntime.LastParryAnimationId = tostring(Threat.Track and Threat.Track.Animation and Threat.Track.Animation.AnimationId or "none")
    AutoParryRuntime.LastPrediction = Threat.LastRemaining or 0
    AutoParryRuntime.LastReach = Threat.Reach or 0
    AutoParryRuntime.LastSkip = "none"
    if AutoParryRuntime.Note then AutoParryRuntime.Note("Parry requested", AutoParryRuntime.LastAttacker .. " " .. tostring(Threat.WeaponName) .. " " .. tostring(Threat.Kind)) end
    pcall(function()
        AutoParryCombat:FireServer("Block", "Block")
    end)
    task.delay(0.09, function()
        pcall(function()
            AutoParryCombat:FireServer("Block", "UnBlock")
        end)
    end)
    return true
end

local function AutoParryRegisterTrack(Player, Character, Track, Restart)
    if AutoParryFlag("AutoParry") ~= true and AutoParryFlag("DodgeEnabled") ~= true then return end
    local Seen = AutoParryRuntime.SeenTracks[Track]
    if Seen and not Restart and (type(Seen) ~= "number" or os.clock() < Seen) then
        return
    end
    local WeaponName = AutoParryWeaponName(Player, Character)
    local Stats = AutoParryGetStats(WeaponName)
    local Diagnostic = AutoParryRuntime.Diagnostics
    if Diagnostic then
        Diagnostic.LastAnimationName = tostring(Track.Animation and Track.Animation.Name or Track.Name or "none")
        Diagnostic.LastAnimationId = tostring(Track.Animation and Track.Animation.AnimationId or "none")
        Diagnostic.LastObservedWeapon = WeaponName
        Diagnostic.LastObservedTarget = Player and Player.Name or Character.Name
    end
    if type(Stats) ~= "table" then
        if Diagnostic then Diagnostic.DeferredTracks += 1 end
        return
    end
    AutoParryRuntime.SeenTracks[Track] = true
    AutoParryRuntime.Threats[Track] = nil
    if Diagnostic then Diagnostic.TracksObserved += 1 end
    local Kind, Classification = AutoParryClassifyAnimation(Stats, Track)
    if not Kind then
        if Classification == "Noncombat" then
            if Diagnostic then Diagnostic.NoncombatTracks += 1 end
        else
            -- Unknown tracks may become classifiable after assets replicate.
            AutoParryRuntime.SeenTracks[Track] = os.clock() + 0.25
            if Diagnostic then
                Diagnostic.UnclassifiedTracks += 1
                if not AutoParryRuntime.UnknownTracks[Track] then
                    AutoParryRuntime.UnknownTracks[Track] = true
                    Diagnostic.UnknownTracks += 1
                else
                    Diagnostic.UnknownTrackRetries += 1
                end
                Diagnostic.LastUnknownAnimationId = Diagnostic.LastAnimationId
                Diagnostic.LastUnknownWeapon = WeaponName
            end
        end
        return
    end
    if not AutoParrySupported(Stats) then
        AutoParryRuntime.Rejected += 1
        AutoParryRuntime.RejectedUnsupported += 1
        AutoParryRuntime.LastRejectReason = "Unsupported weapon"
        AutoParryRuntime.LastRejectedWeapon = WeaponName
        return
    end
    if Stats.Parryable == false and AutoParryFlag("DodgeEnabled") ~= true then
        AutoParryRuntime.Rejected += 1
        AutoParryRuntime.RejectedUnparryable += 1
        AutoParryRuntime.LastRejectReason = "Unparryable attack"
        AutoParryRuntime.LastRejectedWeapon = WeaponName
        return
    end
    local Root = Character:FindFirstChild("HumanoidRootPart")
    local LocalCharacter = AutoParryLocalPlayer and AutoParryLocalPlayer.Character
    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")
    if not Root or not LocalRoot then
        return
    end
    local ImpactKeyTime, Speed, TimingSource = AutoParryImpactKeyTime(Stats, Kind, Track)
    local Threat = {
        Player = Player,
        Character = Character,
        Track = Track,
        Stats = Stats,
        WeaponName = WeaponName,
        Kind = Kind,
        ImpactKeyTime = ImpactKeyTime,
        TimingSource = TimingSource,
        Speed = Speed,
        Reach = AutoParryReach(Stats, Kind),
        Parryable = Stats.Parryable ~= false,
        AccuracyPassed = AutoParryAccuracy(),
        Resolved = false,
        CreatedAt = os.clock(),
        LastRemaining = math.huge
    }
    AutoParryRuntime.Threats[Track] = Threat
    if Diagnostic then
        Diagnostic.RegisteredAttacks += 1
        if AutoParryRuntime.Note then AutoParryRuntime.Note("Attack detected", Diagnostic.LastObservedTarget .. " " .. WeaponName .. " " .. Kind) end
    end
end

local function AutoParryBindCharacter(Player, Character)
    if Player == AutoParryLocalPlayer or not Character then
        return
    end
    local Old = AutoParryRuntime.CharacterConnections[Player]
    if Old then
        for _, Connection in ipairs(Old) do
            pcall(function() Connection:Disconnect() end)
        end
    end
    local List = {}
    AutoParryRuntime.CharacterConnections[Player] = List
    task.spawn(function()
        local Humanoid = Character:FindFirstChildOfClass("Humanoid") or Character:WaitForChild("Humanoid", 10)
        if not Humanoid then
            return
        end
        local Animator = Humanoid:FindFirstChildOfClass("Animator") or Humanoid:WaitForChild("Animator", 10)
        if not Animator or AutoParryRuntime.CharacterConnections[Player] ~= List or Player.Character ~= Character then
            return
        end
        List[#List + 1] = Animator.AnimationPlayed:Connect(function(Track)
            AutoParryRuntime.Diagnostics.AnimationEvents += 1
            local Observe = AutoParryRuntime.Punish.ObserveTrack
            if Observe then
                Observe(Player, Character, Track, true)
            end
            AutoParryRegisterTrack(Player, Character, Track, true)
        end)
    end)
end

local function AutoParryBindPlayer(Player)
    if Player == AutoParryLocalPlayer then
        return
    end
    if Player.Character then
        AutoParryBindCharacter(Player, Player.Character)
    end
    local Connection = Player.CharacterAdded:Connect(function(Character)
        AutoParryBindCharacter(Player, Character)
    end)
    AutoParryRuntime.Connections[#AutoParryRuntime.Connections + 1] = Connection
end

for _, Player in ipairs(AutoParryPlayers:GetPlayers()) do
    AutoParryBindPlayer(Player)
end

AutoParryRuntime.Connections[#AutoParryRuntime.Connections + 1] = AutoParryPlayers.PlayerAdded:Connect(AutoParryBindPlayer)
AutoParryRuntime.Connections[#AutoParryRuntime.Connections + 1] = AutoParryPlayers.PlayerRemoving:Connect(function(Player)
    local List = AutoParryRuntime.CharacterConnections[Player]
    if List then
        for _, Connection in ipairs(List) do
            pcall(function() Connection:Disconnect() end)
        end
        AutoParryRuntime.CharacterConnections[Player] = nil
    end
    AutoParryRuntime.Punish.Foes[Player] = nil
end)

AutoParryRuntime.Connections[#AutoParryRuntime.Connections + 1] = AutoParryRunService.Heartbeat:Connect(function(DeltaTime)
    local Success, Error = pcall(function()
    if AutoParryRuntime.ResolveDependencies then AutoParryRuntime.ResolveDependencies() end
    AutoDodgePoll()
    if AutoParryRuntime.SampleDiagnostics then AutoParryRuntime.SampleDiagnostics(DeltaTime) end
    for Track in pairs(AutoParryRuntime.SeenTracks) do
        if not Track.IsPlaying then
            AutoParryRuntime.SeenTracks[Track] = nil
            AutoParryRuntime.Threats[Track] = nil
        end
    end
    if AutoParryFlag("AutoParry") ~= true and AutoParryFlag("DodgeEnabled") ~= true then
        AutoParryRuntime.ActiveThreats = 0
        return
    end
    local LocalCharacter = AutoParryLocalPlayer and AutoParryLocalPlayer.Character
    local LocalRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")
    if not LocalRoot then
        AutoParryRuntime.ActiveThreats = 0
        return
    end
    for _, Player in ipairs(AutoParryPlayers:GetPlayers()) do
        if Player ~= AutoParryLocalPlayer then
            local Character = Player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
            local Animator = Humanoid and Humanoid:FindFirstChildOfClass("Animator")
            local EnemyRoot = Character and Character:FindFirstChild("HumanoidRootPart")
            if Character and Animator and EnemyRoot and (EnemyRoot.Position - LocalRoot.Position).Magnitude <= 32 then
                for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
                    if AutoParryRuntime.Diagnostics then AutoParryRuntime.Diagnostics.TracksScanned += 1 end
                    local Seen = AutoParryRuntime.SeenTracks[Track]
                    if Track.IsPlaying and (not Seen or type(Seen) == "number" and os.clock() >= Seen) then
                        AutoParryRegisterTrack(Player, Character, Track)
                    end
                end
            end
        end
    end
    local Active = 0
    local Ping = AutoParryPing()
    for Track, Threat in pairs(AutoParryRuntime.Threats) do
        if Threat.Resolved or not Threat.Character.Parent or not Track.IsPlaying then
            AutoParryRuntime.Threats[Track] = nil
            continue
        end
        Active += 1
        local Root = Threat.Character:FindFirstChild("HumanoidRootPart")
        local Humanoid = Threat.Character:FindFirstChildOfClass("Humanoid")
        if not Root or not Humanoid or Humanoid.Health <= 0 or Threat.Player.Character ~= Threat.Character or Threat.Character:GetAttribute("Sheathed") == true or Threat.Character:GetAttribute("IsRagdoll") == true then
            AutoParryRuntime.Threats[Track] = nil
            continue
        end
        Threat.ImpactKeyTime, Threat.Speed, Threat.TimingSource = AutoParryImpactKeyTime(Threat.Stats, Threat.Kind, Track)
        AutoParryRuntime.LastObservedTimingSource = Threat.TimingSource
        local TrackSpeed = Threat.Speed
        pcall(function()
            if tonumber(Track.Speed) and Track.Speed > 0.01 then
                TrackSpeed = Track.Speed
            end
        end)
        local TimePosition = 0
        pcall(function() TimePosition = tonumber(Track.TimePosition) or 0 end)
        local Remaining = (Threat.ImpactKeyTime - TimePosition) / math.max(0.05, TrackSpeed)
        Threat.LastRemaining = Remaining
        local Diagnostic = AutoParryRuntime.Diagnostics
        if Diagnostic then Diagnostic.LastRemaining = Remaining end
        if Remaining < -0.18 then
            if Diagnostic then
                Diagnostic.ExpiredAttacks += 1
                Diagnostic.LastThreatSkip = "Attack timing expired"
            end
            Threat.Resolved = true
            AutoParryRuntime.Threats[Track] = nil
            continue
        end
        local PredictTime = math.max(0, Remaining) + Ping
        local TheirVelocity = Root.AssemblyLinearVelocity or Vector3.zero
        local OurVelocity = LocalRoot.AssemblyLinearVelocity or Vector3.zero
        local TheirFuture = Root.Position + TheirVelocity * PredictTime
        local OurFuture = LocalRoot.Position + OurVelocity * PredictTime
        local Delta = OurFuture - TheirFuture
        local Distance = Delta.Magnitude
        local Facing = 1
        if Delta.Magnitude > 0.001 then
            Facing = Root.CFrame.LookVector:Dot(Delta.Unit)
        end
        local Lead = math.clamp(Ping + 0.07, 0.07, 0.24)
        local Reach = Threat.Reach + 1.25
        if Diagnostic then
            Diagnostic.LastDistance = Distance
            Diagnostic.LastFacing = Facing
            if Remaining > Lead then Diagnostic.LastThreatSkip = "Waiting for impact window"
            elseif Remaining < -0.05 then Diagnostic.LastThreatSkip = "Impact window missed"
            elseif Distance > Reach then Diagnostic.LastThreatSkip = "Out of range"
            elseif Facing < -0.1 then Diagnostic.LastThreatSkip = "Enemy facing away"
            else Diagnostic.LastThreatSkip = "Impact window reached" end
        end
        if Remaining <= Lead and Remaining >= -0.05 and Distance <= Reach and Facing >= -0.1 then
            if Threat.Parryable ~= false and Threat.AccuracyPassed then
                Threat.Resolved = AutoParryFire(Threat)
            elseif Threat.Parryable ~= false and AutoParryFlag("AutoParry") == true and not Threat.AccuracyRecorded then
                Threat.AccuracyRecorded = true
                AutoParryRuntime.AccuracyMisses += 1
            end
            if not Threat.Resolved and AutoParryFlag("DodgeEnabled") == true then
                Threat.Resolved = AutoDodgeFire(Threat)
            elseif not Threat.Resolved and Threat.Parryable ~= false and not Threat.AccuracyPassed then
                Threat.Resolved = true
            end
            if Threat.Resolved then
                AutoParryRuntime.Threats[Track] = nil
            end
        end
    end
    AutoParryRuntime.ActiveThreats = Active
    end)
    if not Success and AutoParryRuntime.Diagnostics then
        AutoParryRuntime.Diagnostics.HeartbeatErrors += 1
        AutoParryRuntime.Diagnostics.LastError = tostring(Error):sub(1, 500)
    end
end)

do
    local AutoPunishWorkspace = game:GetService("Workspace")

    local function AutoPunishFoe(Player, Character)
        local State = AutoParryRuntime.Punish
        local Foe = State.Foes[Player]
        if not Foe or Foe.Character ~= Character then
            Foe = {
                Character = Character,
                Track = nil,
                IgnoredTrack = nil,
                WeaponName = nil,
                TimePosition = 0,
                Length = 0,
                ObservedAt = 0,
                RecoveryUntil = 0,
                AttackEndedAt = nil,
                RecoveryObserved = false,
                RecoveryUsed = false,
                WasStunned = false,
                StunUsed = false
            }
            State.Foes[Player] = Foe
        end
        return Foe
    end

    local function AutoPunishObserveTrack(Player, Character, Track, Restart)
        if AutoParryFlag("AutoPunishEnabled") ~= true or not Track or Player.Character ~= Character then
            return
        end
        local Foe = AutoPunishFoe(Player, Character)
        if Foe.IgnoredTrack == Track and not Restart then
            return
        end
        local WeaponName = AutoParryWeaponName(Player, Character)
        local Stats = AutoParryGetStats(WeaponName)
        if not AutoParrySupported(Stats) or not AutoParryClassifyAnimation(Stats, Track) then
            return
        end
        local Kind = AutoParryClassifyAnimation(Stats, Track)
        local TimePosition = tonumber(Track.TimePosition) or 0
        if Restart or Foe.Track ~= Track or TimePosition < Foe.TimePosition - 0.05 then
            Foe.Track = Track
            Foe.IgnoredTrack = nil
            Foe.WeaponName = WeaponName
            Foe.TimePosition = 0
            Foe.Length = 0
            Foe.RecoveryUntil = 0
            Foe.AttackEndedAt = nil
            Foe.RecoveryObserved = false
            Foe.RecoveryUsed = false
            Foe.RecoveryAttempts = 0
            Foe.RecoveryGeneration = (Foe.RecoveryGeneration or 0) + 1
        end
        Foe.Kind = Kind
        Foe.ImpactKeyTime, Foe.Speed = AutoParryImpactKeyTime(Stats, Kind, Track)
        Foe.TimePosition = TimePosition
        Foe.Length = math.max(Foe.Length, tonumber(Track.Length) or 0)
        Foe.ObservedAt = os.clock()
    end

    local function AutoPunishPollLocal()
        local State = AutoParryRuntime.Punish
        local Character = AutoParryLocalPlayer and AutoParryLocalPlayer.Character
        local Now = os.clock()
        if State.Character ~= Character then
            if State.Pending then
                State.Rejected += 1
            end
            State.Character = Character
            State.WasAttacking = false
            State.Pending = nil
            State.ReadyAt = 0
            State.ResetUntil = 0
            State.LastRequestAt = 0
            State.Foes = {}
        end
        local Attacking = Character and Character:GetAttribute("Attacking") == true or false
        if Attacking and not State.WasAttacking then
            State.ReadyAt = math.max(State.ReadyAt, Now + 0.4)
        end
        if not Attacking and State.WasAttacking then
            local Stats = AutoParryGetStats(AutoParryWeaponName(AutoParryLocalPlayer, Character))
            State.ResetUntil = Now + math.max(0, tonumber(Stats and Stats.Swingreset) or 0.26)
        end
        State.WasAttacking = Attacking
        local Pending = State.Pending
        if Pending then
            if Pending.Character == Character and Attacking then
                State.Started += 1
                if Pending.Reason == "Stunned" and Pending.StunGeneration == (Pending.Foe.StunGeneration or 0) and Pending.Foe.WasStunned then
                    Pending.Foe.StunUsed = true
                end
                if Pending.RecoveryGeneration == (Pending.Foe.RecoveryGeneration or 0) then
                    Pending.Foe.RecoveryUsed = true
                end
                State.LastSkip = "none"
                AutoParryRuntime.Note("Punish started", State.LastTarget .. " " .. State.LastReason)
                State.Pending = nil
            elseif not Character or not Character.Parent or Now >= Pending.Deadline then
                State.Rejected += 1
                State.LastSkip = "Native swing did not start"
                AutoParryRuntime.Note("Punish rejected", State.LastTarget .. " " .. State.LastSkip)
                State.Pending = nil
            end
        end
    end

    local function AutoPunishLocalReady(Ping)
        local State = AutoParryRuntime.Punish
        if State.Pending or AutoParryRuntime.Dodge.Pending then
            State.LastSkip = "Queued combat action"
            return nil
        end
        local Character = State.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        if not Character or not Character.Parent or not Humanoid or Humanoid.Health <= 0 or not Root or Humanoid.SeatPart then
            State.LastSkip = "Local character unavailable"
            return nil
        end
        local WeaponName = AutoParryWeaponName(AutoParryLocalPlayer, Character)
        local Stats = AutoParryGetStats(WeaponName)
        if not AutoParrySupported(Stats) then
            State.LastSkip = "Unsupported melee weapon: " .. WeaponName
            return nil
        end
        if Character:GetAttribute("Sheathed") ~= false then
            State.LastSkip = "Weapon sheathed"
            return nil
        end
        if Character:FindFirstChildOfClass("Tool") then
            State.LastSkip = "Held tool blocks native swing"
            return nil
        end
        for _, Name in ipairs({"Stunned", "IsRagdoll", "Attacking", "Blocking", "Dashing", "Disabled", "Emoting", "DSL", "Knocked", "GarouStunned"}) do
            if Character:GetAttribute(Name) == true then
                State.LastSkip = "Local " .. Name
                return nil
            end
        end
        local Stamina = tonumber(Character:GetAttribute("Stamina"))
        if Stamina and Stamina < (tonumber(Stats.LightStamina) or 0) then
            State.LastSkip = "Insufficient swing stamina"
            return nil
        end
        local Now = os.clock()
        if Now < (State.ResetUntil or 0) then
            State.LastSkip = "Swing reset"
            return nil
        end
        if Now < State.ReadyAt or Now - State.LastRequestAt < 0.4 then
            State.LastSkip = "Swing cooldown"
            return nil
        end
        if Now - AutoParryRuntime.LastParryAt < math.max(0.18, Ping * 2 + 0.05) then
            State.LastSkip = "Recent parry"
            return nil
        end
        local Mechanics = Character:FindFirstChild("Mechanics")
        local Client = Mechanics and Mechanics:FindFirstChild("Client")
        local Action = Client and Client:FindFirstChild("MobileAction") or Character:FindFirstChild("MobileAction", true)
        if not Action or not Action:IsA("BindableEvent") then
            State.LastSkip = "Native swing action unavailable"
            return nil
        end
        return Character, Root, Stats, WeaponName, Action
    end

    local function AutoPunishInReach(Root, EnemyRoot, Stats, Ping)
        local Delta = EnemyRoot.Position - Root.Position
        local Distance = Delta.Magnitude
        local Reach = math.min(15.75, AutoParryReach(Stats, "M1"))
        if Distance <= 0.5 or Distance > Reach or Root.CFrame.LookVector:Dot(Delta.Unit) < 0.3420201433256688 then
            return false
        end
        local LookAhead = math.clamp(0.3 / math.max(0.05, tonumber(Stats.SwingSpeed) or 1) + Ping, 0.15, 0.55)
        local FutureDelta = Delta + ((EnemyRoot.AssemblyLinearVelocity or Vector3.zero) - (Root.AssemblyLinearVelocity or Vector3.zero)) * LookAhead
        local Height = typeof(Stats.M1HitboxSize) == "Vector3" and Stats.M1HitboxSize.Y * 0.5 + 2 or 3
        return FutureDelta.Magnitude <= Reach and math.abs(Delta.Y) <= Height and math.abs(FutureDelta.Y) <= Height
    end

    local function AutoPunishClearPath(Character, Root, Enemy, EnemyRoot)
        local Params = RaycastParams.new()
        Params.FilterType = Enum.RaycastFilterType.Exclude
        Params.FilterDescendantsInstances = {Character, Enemy}
        local Origin = Root.Position + Vector3.new(0, 1, 0)
        local End = EnemyRoot.Position + Vector3.new(0, 1, 0)
        return AutoPunishWorkspace:Raycast(Origin, End - Origin, Params) == nil
    end

    local function AutoPunishNativeTarget(Character, Root)
        local Nearest = nil
        local NearestDistance = math.huge
        local HasContainers = false
        for _, Name in ipairs({"Living", "Enemy", "Monsters"}) do
            local Folder = AutoPunishWorkspace:FindFirstChild(Name)
            if Folder then
                HasContainers = true
                for _, Enemy in ipairs(Folder:GetChildren()) do
                    if Enemy:IsA("Model") and Enemy ~= Character then
                        local Humanoid = Enemy:FindFirstChildOfClass("Humanoid")
                        local EnemyRoot = Enemy:FindFirstChild("HumanoidRootPart")
                        if Humanoid and Humanoid.Health > 0 and EnemyRoot then
                            local Delta = EnemyRoot.Position - Root.Position
                            local Distance = Delta.Magnitude
                            if Distance > 0.5 and Distance <= 16 and Distance < NearestDistance and Root.CFrame.LookVector:Dot(Delta.Unit) >= 0.3420201433256688 then
                                Nearest = Enemy
                                NearestDistance = Distance
                            end
                        end
                    end
                end
            end
        end
        return Nearest, HasContainers
    end

    local function AutoPunishFire(Candidate, Ping)
        local State = AutoParryRuntime.Punish
        local Character, Root, Stats, WeaponName, Action = AutoPunishLocalReady(Ping)
        if not Character or AutoParryFlag("AutoPunishEnabled") ~= true then
            return
        end
        local Now = os.clock()
        local Foe = Candidate.Foe
        if Candidate.Player.Character ~= Foe.Character or not Foe.Character.Parent then
            return
        end
        if Candidate.Reason == "Stunned" then
            Foe.StunAttempts = (Foe.StunAttempts or 0) + 1
        else
            Foe.RecoveryAttempts = (Foe.RecoveryAttempts or 0) + 1
        end
        State.LastRequestAt = Now
        State.ReadyAt = Now + 0.4
        State.Pending = {Character = Character, Foe = Foe, Reason = Candidate.Reason, StunGeneration = Foe.StunGeneration or 0, RecoveryGeneration = Foe.RecoveryGeneration or 0, Deadline = Now + math.max(0.35, Ping * 2 + 0.15)}
        State.LastTarget = Candidate.Player.Name
        State.LastReason = Candidate.Reason
        State.LastWeapon = WeaponName
        State.LastWindowRemaining = Candidate.Reason == "AttackRecovery" and math.max(0, Foe.RecoveryUntil - Now) or 0
        local Success, Error = pcall(function()
            Action:Fire("Swing")
        end)
        if not Success then
            State.FireErrors += 1
            State.LastFireError = tostring(Error):sub(1, 240)
            State.LastSkip = "Native swing action error"
            State.Pending = nil
            return
        end
        State.Requests += 1
        State.LastSkip = "none"
        AutoParryRuntime.Note("Punish requested", State.LastTarget .. " " .. State.LastReason)
        AutoPunishPollLocal()
    end

    local function AutoPunishPulse()
        AutoPunishPollLocal()
        local State = AutoParryRuntime.Punish
        if AutoParryFlag("AutoPunishEnabled") ~= true then
            State.Foes = {}
            State.LastSkip = "Disabled"
            return
        end
        local Character = State.Character
        local Root = Character and Character:FindFirstChild("HumanoidRootPart")
        if not Root then
            State.LastSkip = "Local character unavailable"
            return
        end
        local Now = os.clock()
        local Ping = AutoParryPing()
        local LocalStats = AutoParryGetStats(AutoParryWeaponName(AutoParryLocalPlayer, Character))
        local Candidate = nil
        local NearestPlayer = nil
        local NearestDistance = math.huge
        local Incoming = false
        for _, Player in ipairs(AutoParryPlayers:GetPlayers()) do
            if Player ~= AutoParryLocalPlayer then
                local Enemy = Player.Character
                local Humanoid = Enemy and Enemy:FindFirstChildOfClass("Humanoid")
                local EnemyRoot = Enemy and Enemy:FindFirstChild("HumanoidRootPart")
                if Enemy and Enemy.Parent and Humanoid and Humanoid.Health > 0 and EnemyRoot then
                    local Delta = EnemyRoot.Position - Root.Position
                    local Distance = Delta.Magnitude
                    if Distance <= 32 then
                        local Foe = AutoPunishFoe(Player, Enemy)
                        local WeaponName = AutoParryWeaponName(Player, Enemy)
                        local Stats = AutoParryGetStats(WeaponName)
                        if Foe.WeaponName and Foe.WeaponName ~= WeaponName then
                            Foe.IgnoredTrack = Foe.Track or Foe.IgnoredTrack
                            Foe.WeaponName = WeaponName
                            Foe.Track = nil
                            Foe.RecoveryUntil = 0
                            Foe.RecoveryObserved = true
                        end
                        local Animator = Humanoid:FindFirstChildOfClass("Animator")
                        local CurrentTrack = nil
                        if Animator and AutoParrySupported(Stats) then
                            for _, Track in ipairs(Animator:GetPlayingAnimationTracks()) do
                                if Track.IsPlaying and AutoParryClassifyAnimation(Stats, Track) and (not CurrentTrack or Track.TimePosition < CurrentTrack.TimePosition) then
                                    CurrentTrack = Track
                                end
                            end
                        end
                        if CurrentTrack then
                            AutoPunishObserveTrack(Player, Enemy, CurrentTrack, false)
                        end
                        local Stunned = Enemy:GetAttribute("Stunned") == true or Enemy:GetAttribute("GarouStunned") == true
                        if Stunned and not Foe.WasStunned then
                            Foe.StunGeneration = (Foe.StunGeneration or 0) + 1
                        end
                        if not Stunned then
                            Foe.StunUsed = false
                            Foe.StunAttempts = 0
                        end
                        Foe.WasStunned = Stunned
                        local Attacking = Enemy:GetAttribute("Attacking") == true
                        if Attacking then
                            Foe.AttackEndedAt = nil
                        elseif Foe.WasAttacking and Foe.Track and not Foe.RecoveryObserved then
                            Foe.AttackEndedAt = Now
                            State.RecoveryEnds = (State.RecoveryEnds or 0) + 1
                        end
                        if Foe.Track and not Attacking and Foe.AttackEndedAt and not Foe.RecoveryObserved then
                            local EndAge = Now - Foe.AttackEndedAt
                            Foe.Length = math.max(Foe.Length, tonumber(Foe.Track.Length) or 0)
                            Foe.ImpactKeyTime, Foe.Speed = AutoParryImpactKeyTime(Stats, Foe.Kind or "M1", Foe.Track)
                            local Progress = math.max(Foe.TimePosition, tonumber(Foe.Track.TimePosition) or 0)
                            if Foe.Track.IsPlaying then
                                Progress = math.max(Progress, Foe.TimePosition + math.min(0.07, math.max(0, Now - Foe.ObservedAt)) * (Foe.Speed or 1))
                            end
                            if Enemy:HasTag("Feinted") then
                                Foe.RecoveryObserved = true
                                State.LastRecoverySkip = "Feinted attack"
                            elseif EndAge > 0.1 or Now - Foe.ObservedAt > 0.35 then
                                Foe.RecoveryObserved = true
                                State.LastRecoverySkip = "Attack end timing expired"
                            elseif Foe.Length <= 0.05 then
                                State.LastRecoverySkip = "Animation length still loading"
                            elseif Progress < (Foe.ImpactKeyTime or Foe.Length * 0.8) + 0.03 then
                                State.LastRecoverySkip = "Waiting for post-hit animation position"
                            else
                                Foe.RecoveryObserved = true
                                Foe.RecoveryUntil = Foe.AttackEndedAt + math.clamp(tonumber(Stats and Stats.Swingreset) or 0.2, 0.12, 0.32)
                                State.RecoveryWindows = (State.RecoveryWindows or 0) + 1
                                if EndAge > 0 then State.LateRecoveryWindows = (State.LateRecoveryWindows or 0) + 1 end
                                State.LastRecoverySkip = "none"
                            end
                        end
                        Foe.WasAttacking = Attacking
                        local EnemyReady = Enemy:GetAttribute("IsRagdoll") ~= true and Enemy:GetAttribute("Knocked") ~= true
                        if Distance > 0.5 and Distance <= 16 and Root.CFrame.LookVector:Dot(Delta.Unit) >= 0.3420201433256688 and Distance < NearestDistance then
                            NearestPlayer = Player
                            NearestDistance = Distance
                        end
                        if Attacking and not Stunned and EnemyReady then
                            local Reach = AutoParrySupported(Stats) and AutoParryReach(Stats, "Heavy") + 1.25 or 8
                            if Distance <= Reach and (Distance <= 0.001 or EnemyRoot.CFrame.LookVector:Dot((Delta * -1).Unit) >= -0.1) then
                                Incoming = true
                            end
                        end
                        local Reason = nil
                        if Stunned and not Foe.StunUsed and (Foe.StunAttempts or 0) < 2 then
                            Reason = "Stunned"
                        elseif not Attacking and not Foe.RecoveryUsed and (Foe.RecoveryAttempts or 0) < 2 and Foe.RecoveryUntil - Now >= math.clamp(Ping + 0.025, 0.05, 0.205) then
                            Reason = "AttackRecovery"
                        end
                        if Reason then
                            local Filter = nil
                            if not EnemyReady then
                                Filter = "Target ragdolled or knocked"
                            elseif Enemy:GetAttribute("Disabled") == true then
                                Filter = "Target disabled"
                            elseif Enemy:GetAttribute("Dashing") == true then
                                Filter = "Target dashing"
                            elseif Enemy:GetAttribute("Blocking") == true then
                                Filter = "Target blocking"
                            elseif not AutoParrySupported(LocalStats) then
                                Filter = "Local melee weapon unavailable"
                            elseif not AutoPunishInReach(Root, EnemyRoot, LocalStats, Ping) then
                                Filter = "Target outside predicted swing reach or facing"
                            elseif not AutoPunishClearPath(Character, Root, Enemy, EnemyRoot) then
                                Filter = "Target obstructed"
                            end
                            State.LastCandidateFilter = Filter or "none"
                            if not Filter and (not Candidate or Distance < Candidate.Distance) then
                                Candidate = {Player = Player, Foe = Foe, Reason = Reason, Distance = Distance}
                            end
                        end
                    else
                        State.Foes[Player] = nil
                    end
                else
                    State.Foes[Player] = nil
                end
            end
        end
        if not AutoPunishLocalReady(Ping) then
            return
        end
        if Incoming then
            State.LastSkip = "Incoming attack"
            return
        end
        if not Candidate then
            State.LastSkip = "No safe punish window"
            return
        end
        if NearestPlayer and Candidate.Player ~= NearestPlayer then
            State.LastSkip = "Closer enemy in swing cone"
            return
        end
        local NativeTarget, HasContainers = AutoPunishNativeTarget(Character, Root)
        if HasContainers and NativeTarget ~= Candidate.Foe.Character then
            State.LastSkip = "Native swing selects another target"
            return
        end
        if not HasContainers then
            local Delta = Candidate.Foe.Character:FindFirstChild("HumanoidRootPart").Position - Root.Position
            if Delta.Magnitude <= 0.001 or Root.CFrame.LookVector:Dot(Delta.Unit) < 0.95 then
                State.LastSkip = "Target outside forward swing"
                return
            end
        end
        AutoPunishFire(Candidate, Ping)
    end

    AutoParryRuntime.Punish.ObserveTrack = AutoPunishObserveTrack
    AutoParryRuntime.Connections[#AutoParryRuntime.Connections + 1] = AutoParryRunService.Heartbeat:Connect(function()
        local State = AutoParryRuntime.Punish
        local Now = os.clock()
        local Success, Error = pcall(function()
            AutoPunishPollLocal()
            if AutoParryFlag("AutoPunishEnabled") ~= true then
                State.Foes = {}
                State.LastSkip = "Disabled"
                State.NextScanAt = 0
                return
            end
            local NextScanAt = State.NextScanAt or 0
            if Now < NextScanAt then
                State.SkippedScans = (State.SkippedScans or 0) + 1
                return
            end
            if Now - NextScanAt >= 1 / 30 then NextScanAt = Now end
            State.NextScanAt = NextScanAt + 1 / 30
            local StartedAt = os.clock()
            AutoPunishPulse()
            State.LastScanMs = (os.clock() - StartedAt) * 1000
            State.MaxScanMs = math.max(State.MaxScanMs or 0, State.LastScanMs)
            State.ScanCount = (State.ScanCount or 0) + 1
        end)
        if not Success then
            State.ScanErrors = (State.ScanErrors or 0) + 1
            State.LastScanError = tostring(Error):sub(1, 500)
            State.LastSkip = "Punish scan error"
        end
    end)
end

