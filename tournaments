local function ArrowVisualFindCharacterFromPart(Part)
    local Current = Part
    while Current and Current ~= ArrowVisualWorkspace do
        if Current:IsA("Model") and Current:FindFirstChildOfClass("Humanoid") then
            return Current
        end
        Current = Current.Parent
    end
    return nil
end

local function ArrowVisualFindImpactTarget(Position, Arrow)
    local Params = OverlapParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    local Ignore = {Arrow}
    local Character = ArrowVisualLocalPlayer and ArrowVisualLocalPlayer.Character
    if Character then
        Ignore[#Ignore + 1] = Character
    end
    Params.FilterDescendantsInstances = Ignore
    local Success, Parts = pcall(function()
        return ArrowVisualWorkspace:GetPartBoundsInRadius(Position, 3.5, Params)
    end)
    if not Success then
        return nil
    end
    local Best = nil
    local BestDistance = math.huge
    for _, Part in ipairs(Parts) do
        local Model = ArrowVisualFindCharacterFromPart(Part)
        if Model then
            local Player = ArrowVisualPlayers:GetPlayerFromCharacter(Model)
            if Player and Player ~= ArrowVisualLocalPlayer then
                local Distance = (Part.Position - Position).Magnitude
                if Distance < BestDistance then
                    Best = Model
                    BestDistance = Distance
                end
            end
        end
    end
    return Best
end

local function ArrowVisualArrowDirection(Tracker)
    local Motion = Tracker.LastDirection
    local Direction = nil

    if Tracker.Part and Tracker.Part.Parent then
        pcall(function()
            Direction = -Tracker.Part.CFrame.UpVector
        end)
    end

    if typeof(Direction) == "Vector3" and Direction.Magnitude > 0.001 then
        Direction = Direction.Unit
        if typeof(Motion) == "Vector3" and Motion.Magnitude > 0.001 and Direction:Dot(Motion.Unit) < 0 then
            Direction = -Direction
        end
        return Direction
    end

    if typeof(Motion) == "Vector3" and Motion.Magnitude > 0.001 then
        return Motion.Unit
    end

    if Tracker.Part and Tracker.Part.Parent then
        local Success, Velocity = pcall(function()
            return Tracker.Part.AssemblyLinearVelocity
        end)
        if Success and typeof(Velocity) == "Vector3" and Velocity.Magnitude > 0.001 then
            return Velocity.Unit
        end
    end

    return Vector3.new(0, 0, -1)
end

local function ArrowVisualPivotPosition(Tracker)
    if Tracker.Object and Tracker.Object.Parent and Tracker.Object:IsA("Model") then
        local Success, Pivot = pcall(function()
            return Tracker.Object:GetPivot()
        end)
        if Success and typeof(Pivot) == "CFrame" then
            return Pivot.Position
        end
    end
    if Tracker.Part and Tracker.Part.Parent then
        return Tracker.Part.Position
    end
    return Tracker.LastPosition
end

local function ArrowVisualFrontPosition(Tracker)
    local Direction = ArrowVisualArrowDirection(Tracker)
    local Pivot = ArrowVisualPivotPosition(Tracker)
    if typeof(Pivot) ~= "Vector3" then
        return nil, Direction
    end

    local TipOffset = 1.5
    if Tracker.Object and Tracker.Object.Parent then
        pcall(function()
            TipOffset = tonumber(Tracker.Object:GetAttribute("TipOffset")) or TipOffset
        end)
    end

    return Pivot + Direction * TipOffset, Direction
end

local function ArrowVisualResolveImpact(Tracker, Position)
    local TipPosition, Direction = ArrowVisualFrontPosition(Tracker)
    if typeof(Direction) ~= "Vector3" or Direction.Magnitude <= 0.001 then
        Direction = Vector3.new(0, 0, -1)
    else
        Direction = Direction.Unit
    end

    local EmbedDepth = 0.35
    if type(ArrowVisualBowConfig) == "table" then
        EmbedDepth = tonumber(ArrowVisualBowConfig.ArrowEmbedDepth) or EmbedDepth
    end

    local SurfacePosition = typeof(TipPosition) == "Vector3"
        and (TipPosition - Direction * EmbedDepth)
        or Position

    if typeof(SurfacePosition) ~= "Vector3" then
        SurfacePosition = Tracker.LastPosition
    end

    if typeof(SurfacePosition) ~= "Vector3" then
        return nil, -Direction, nil
    end

    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    local Ignore = {Tracker.Object}
    local Character = ArrowVisualLocalPlayer and ArrowVisualLocalPlayer.Character
    if Character then
        Ignore[#Ignore + 1] = Character
    end
    Params.FilterDescendantsInstances = Ignore

    local Result = nil
    pcall(function()
        Result = ArrowVisualWorkspace:Raycast(
            SurfacePosition - Direction * 1.25,
            Direction * 2.5,
            Params
        )
    end)

    if Result then
        return Result.Position, Result.Normal, Result.Instance
    end

    return SurfacePosition, -Direction, nil
end

local function ArrowVisualImpactMaterial()
    local Value = ArrowVisualFlag("ArrowImpactMaterial", "Neon")
    if type(Value) == "table" then
        Value = Value[1]
    end
    return tostring(Value) == "ForceField" and Enum.Material.ForceField or Enum.Material.Neon
end

local function ArrowVisualImpactCFrame(Position, Normal)
    Normal = typeof(Normal) == "Vector3" and Normal or Vector3.yAxis
    if Normal.Magnitude <= 0.001 then
        Normal = Vector3.yAxis
    else
        Normal = Normal.Unit
    end
    local UpHint = math.abs(Normal:Dot(Vector3.yAxis)) > 0.98 and Vector3.xAxis or Vector3.yAxis
    local Back = Normal:Cross(UpHint)
    if Back.Magnitude <= 0.001 then
        Back = Vector3.zAxis
    else
        Back = Back.Unit
    end
    local Up = Back:Cross(Normal).Unit
    return CFrame.fromMatrix(Position, Normal, Up, Back)
end

local function ArrowVisualCreateSurfaceImpact(Position, Normal, HitInstance)
    if ArrowVisualFlag("ArrowImpactEnabled", false) ~= true or typeof(Position) ~= "Vector3" then
        return
    end
    local Color1 = ArrowVisualFlag("ArrowImpactColor1", ArrowVisualAccent())
    if typeof(Color1) ~= "Color3" then Color1 = ArrowVisualAccent() end
    local Size = math.clamp(tonumber(ArrowVisualFlag("ArrowImpactSize", 0.25)) or 0.25, 0.05, 1)
    local Depth = math.max(0.035, Size * 0.47)
    local BaseCFrame = ArrowVisualImpactCFrame(Position, Normal)
    local AttachTo = typeof(HitInstance) == "Instance" and HitInstance:IsA("BasePart") and HitInstance or nil
    local Part = Instance.new("Part")
    Part.Name = "EveArrowImpactMarker"
    Part.Anchored = AttachTo == nil
    Part.Massless = true
    Part.CanCollide = false
    Part.CanTouch = false
    Part.CanQuery = false
    Part.CastShadow = false
    Part.Shape = Enum.PartType.Block
    Part.Material = ArrowVisualImpactMaterial()
    Part.MaterialVariant = ""
    Part.Color = Color1
    Part.Size = Vector3.new(Depth, Size, Size)
    Part.CFrame = BaseCFrame + BaseCFrame.RightVector * (Depth * 0.5 + 0.006)
    Part.Transparency = 0
    Part.Parent = ArrowVisualWorkspace
    if AttachTo then
        local Weld = Instance.new("WeldConstraint")
        Weld.Part0 = Part
        Weld.Part1 = AttachTo
        Weld.Parent = Part
    end
    ArrowVisualRuntime.SurfaceImpacts += 1
    ArrowVisualTweenService:Create(Part, TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {Transparency = 1}):Play()
    task.delay(2.05, function()
        if Part and Part.Parent then
            Part:Destroy()
        end
    end)
end

local function ArrowVisualCloneCharacter(Character, Name)
    if not Character or not Character.Parent then
        return
    end
    local Model = Instance.new("Model")
    Model.Name = "EveArrowHitClone"
    local Color = ArrowVisualHitEffectColor()
    local Alpha = 0.25
    local Outline = Name == "Outline"
    local Material = Name == "Forcefield" and Enum.Material.ForceField or Enum.Material.Neon
    local Parts = {}

    for _, Original in ipairs(Character:GetDescendants()) do
        if Original:IsA("BasePart") and Original.Name ~= "HumanoidRootPart" and Original.Transparency < 0.98 then
            local Success, Part = pcall(function()
                return Original:Clone()
            end)
            if Success and Part then
                for _, Child in ipairs(Part:GetChildren()) do
                    Child:Destroy()
                end
                Part.Anchored = true
                Part.CanCollide = false
                Part.CanTouch = false
                Part.CanQuery = false
                Part.CastShadow = false
                Part.CFrame = Original.CFrame
                if Part:IsA("MeshPart") then
                    pcall(function()
                        Part.TextureID = ""
                    end)
                end
                if Outline then
                    Part.Transparency = 1
                    local Box = Instance.new("SelectionBox")
                    Box.Name = "EveArrowHitOutline"
                    Box.Adornee = Part
                    Box.Color3 = Color
                    Box.LineThickness = 0.025
                    Box.Transparency = Alpha
                    Box.Parent = Part
                else
                    Part.Material = Material
                    Part.Color = Color
                    Part.Transparency = Alpha
                end
                Part.Parent = Model
                Parts[#Parts + 1] = Part
            end
        end
    end

    if #Parts == 0 then
        Model:Destroy()
        return
    end

    Model.Parent = ArrowVisualWorkspace
    ArrowVisualRuntime.ImpactEffects += 1
    task.delay(0.55, function()
        if not Model.Parent then
            return
        end
        local Fade = 0.25
        for _, Part in ipairs(Parts) do
            if Part.Parent then
                if Outline then
                    local Box = Part:FindFirstChild("EveArrowHitOutline")
                    if Box then
                        ArrowVisualTweenService:Create(Box, TweenInfo.new(Fade), {Transparency = 1}):Play()
                    end
                else
                    ArrowVisualTweenService:Create(Part, TweenInfo.new(Fade), {Transparency = 1}):Play()
                end
            end
        end
        task.delay(Fade + 0.03, function()
            if Model.Parent then
                Model:Destroy()
            end
        end)
    end)
end

local function ArrowVisualApplyHitEffects(Target, ImpactPosition)
    if ArrowVisualFlag("ArrowHitEffectsEnabled", false) ~= true or not Target then
        return
    end

    local Types = ArrowVisualImpactTypes()
    ArrowVisualRuntime.LastImpactType = table.concat(Types, ", ")
    ArrowVisualRuntime.HitEffectEvents += 1

    for _, Name in ipairs(Types) do
        if Name == "Sparks" or Name == "Bubble" or Name == "Orbs" or Name == "Air" then
            ArrowVisualEmitParticle(Name, ImpactPosition)
        elseif Name == "Neon" or Name == "Forcefield" or Name == "Outline" then
            ArrowVisualCloneCharacter(Target, Name)
        end
    end
end

local function ArrowVisualCreateImpact(Tracker, Position)
    if Tracker.ImpactDone then
        return
    end
    Tracker.ImpactDone = true
    ArrowVisualDisableTracer(Tracker)
    ArrowVisualRuntime.Impacts += 1

    local ImpactPosition, ImpactNormal, HitInstance = ArrowVisualResolveImpact(Tracker, Position)
    ArrowVisualCreateSurfaceImpact(ImpactPosition, ImpactNormal, HitInstance)

    local Target = ArrowVisualFindImpactTarget(ImpactPosition, Tracker.Object)
    ArrowVisualRuntime.LastImpactTarget = Target and Target.Name or "none"

    ArrowVisualApplyHitEffects(Target, ImpactPosition)
end

local function ArrowVisualTrack(Object, Origin)
    if not Object or not Object.Parent or Object.Name ~= "FlyingArrow" or ArrowVisualRuntime.Trackers[Object] then
        return
    end
    local Part = ArrowVisualPart(Object)
    if not Part then
        return
    end
    local Start = typeof(Origin) == "Vector3" and Origin or Part.Position
    local Tracker = {
        Object = Object,
        Part = Part,
        StartPosition = Start,
        LastPosition = Part.Position,
        LastDirection = nil,
        Moved = false,
        ImpactDone = false,
        LastGameTrailEnabled = nil,
        CustomTrail = nil,
        Attachment0 = nil,
        Attachment1 = nil,
        GameTrail = nil,
        GameTrailOriginal = nil,
        GameTrailReplaced = false,
        TracerStyle = nil,
