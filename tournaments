    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    if not Character or not Character.Parent or not Humanoid or Humanoid.Health <= 0 or Character:GetAttribute("Sheathed") ~= false then
        return false
    end
    if type(BowSilentBowConfig) ~= "table" or type(BowSilentBowConfig.IsBowEquipped) ~= "function" then
