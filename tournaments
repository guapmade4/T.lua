local function BowSilentNewDrawing(ClassName)
    local Frame = Instance.new("Frame")
    Frame.Name = ClassName
    Frame.AnchorPoint = Vector2.new(0.5, 0.5)
    Frame.BorderSizePixel = 0
    Frame.BackgroundTransparency = 1
    Frame.Visible = false
    Frame.Active = false
    Frame.Parent = BowSilentGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(1, 0)
    Corner.Parent = Frame

    local Stroke = nil
    if ClassName == "Circle" then
        Stroke = Instance.new("UIStroke")
        Stroke.Name = "Core"
        Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        Stroke.Parent = Frame
        pcall(function()
            Stroke.StrokeSizingMode = Enum.StrokeSizingMode.FixedSize
            Stroke.BorderStrokePosition = Enum.BorderStrokePosition.Center
            Stroke.LineJoinMode = Enum.LineJoinMode.Round
            Stroke.ZIndex = 2
        end)
    end

    local Outline = Instance.new("UIStroke")
    Outline.Name = "Outline"
    Outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    Outline.Parent = Frame
    pcall(function()
        Outline.StrokeSizingMode = Enum.StrokeSizingMode.FixedSize
        Outline.BorderStrokePosition = ClassName == "Circle" and Enum.BorderStrokePosition.Center or Enum.BorderStrokePosition.Outer
        Outline.LineJoinMode = Enum.LineJoinMode.Round
        Outline.ZIndex = 1
    end)

    local Values = {
        Position = Vector2.zero,
        From = Vector2.zero,
        To = Vector2.zero,
        Radius = 1,
        Thickness = BowSilentStrokeStyle.Thickness,
        OutlineThickness = BowSilentStrokeStyle.OutlineThickness,
        Color = Color3.fromRGB(255, 255, 255),
        Transparency = BowSilentStrokeStyle.Transparency,
        OutlineColor = BowSilentStrokeStyle.OutlineColor,
        OutlineTransparency = BowSilentStrokeStyle.OutlineTransparency,
        Visible = false,
        ZIndex = 2
    }
    local Removed = false
    local function Update()
        if Removed then
            return
        end
        Frame.ZIndex = Values.ZIndex
        Frame.Visible = Values.Visible
        Outline.Enabled = Values.OutlineThickness > 0
        Outline.Color = Values.OutlineColor
        Outline.Transparency = 1 - math.clamp(Values.OutlineTransparency, 0, 1)
        if Stroke then
            Frame.Position = UDim2.fromOffset(Values.Position.X, Values.Position.Y)
            Frame.Size = UDim2.fromOffset(Values.Radius * 2, Values.Radius * 2)
            Stroke.Thickness = Values.Thickness
            Stroke.Color = Values.Color
            Stroke.Transparency = 1 - math.clamp(Values.Transparency, 0, 1)
            Outline.Thickness = Values.Thickness + Values.OutlineThickness * 2
        else
            local Delta = Values.To - Values.From
            local Center = (Values.From + Values.To) * 0.5
            Frame.Position = UDim2.fromOffset(Center.X, Center.Y)
            Frame.Size = UDim2.fromOffset(Delta.Magnitude, Values.Thickness)
            Frame.Rotation = math.deg(math.atan2(Delta.Y, Delta.X))
            Frame.BackgroundColor3 = Values.Color
            Frame.BackgroundTransparency = 1 - math.clamp(Values.Transparency, 0, 1)
            Outline.Thickness = Values.OutlineThickness
        end
    end
    Values.Remove = function()
        if Removed then
            return
        end
        Removed = true
        Frame:Destroy()
    end
    Values.Style = function(Color)
        Values.Thickness = BowSilentStrokeStyle.Thickness
        Values.OutlineThickness = BowSilentStrokeStyle.OutlineThickness
        Values.Transparency = BowSilentStrokeStyle.Transparency
        Values.OutlineColor = BowSilentStrokeStyle.OutlineColor
        Values.OutlineTransparency = BowSilentStrokeStyle.OutlineTransparency
        Values.Color = Color
        Update()
    end
    Update()
    return setmetatable({}, {
        __index = Values,
        __newindex = function(_, Key, Value)
            Values[Key] = Value
            Update()
        end
    })
end

