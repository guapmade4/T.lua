local DebugSaveSequence = 0

local function CreateUniqueDebugFile(Name)
    if typeof(isfolder) ~= "function" or typeof(makefolder) ~= "function" then
        return nil, "folder functions unavailable"
    end

    local Base = tostring(Window.DebugFolder or ((Window.StorageFolder or "Eve") .. "/debug"))

    if not isfolder(Base) then
        makefolder(Base)
    end

    DebugSaveSequence += 1
    local Stamp = os.date("%Y-%m-%d_%H-%M-%S")
    local Millis = tostring(DateTime.now().UnixTimestampMillis % 1000)
    local Prefix = Base .. "/" .. tostring(Name) .. "-" .. Stamp .. "-" .. Millis .. "-" .. tostring(DebugSaveSequence)
    local Path = Prefix .. ".txt"

    if typeof(isfile) == "function" then
        local Suffix = 1
        while isfile(Path) do
            Suffix += 1
            Path = Prefix .. "-" .. tostring(Suffix) .. ".txt"
        end
    end

    return Path
end

