    BowSilentSolverState.Original = BowSilentBowConfig.SolveLaunchDirection
end

local BowSilentNativeSolveLaunchDirection = BowSilentSolverState.Original

local function BowSilentRedirectDirection(Origin, Direction, Force, CountRedirect, GravityOverride)
    if BowSilentFlag("BowSilentEnabled") ~= true then
        return Direction
    end
    if typeof(Origin) ~= "Vector3" or typeof(Direction) ~= "Vector3" then
        return Direction
    end
    if type(BowSilentNativeSolveLaunchDirection) ~= "function" then
        return Direction
    end

    local Speed = tonumber(Force) or 0
    if Speed <= 0 then
        return Direction
    end

    local Target, Head = BowSilentAcquireTarget()
    if not Target or not Head or not Head.Parent then
        return Direction
    end

    local Gravity = tonumber(GravityOverride) or 0
    if Gravity <= 0 and type(BowSilentBowConfig) == "table" and type(BowSilentBowConfig.GravityFromForce) == "function" then
        local Success, Value = pcall(BowSilentBowConfig.GravityFromForce, Speed)
        if Success then
            Gravity = tonumber(Value) or 0
        end
    end

    local HeadPosition = Head.Position
    local Velocity = BowSilentVelocity(Target, Head)
    local PingCompensation = BowSilentPingCompensation()
    local TravelTime = math.clamp((HeadPosition - Origin).Magnitude / math.max(Speed, 1), 0, 4)
    local PredictedPosition = HeadPosition
    local SolvedDirection = nil

    for _ = 1, 6 do
        PredictedPosition = HeadPosition + Velocity * (TravelTime + PingCompensation)
        local Success, Result = pcall(BowSilentNativeSolveLaunchDirection, Origin, PredictedPosition, Speed, Gravity)
        if not Success or typeof(Result) ~= "Vector3" or Result.Magnitude < 0.001 then
            SolvedDirection = nil
            break
        end

        SolvedDirection = Result.Unit
        local Offset = PredictedPosition - Origin
        local HorizontalDistance = Vector3.new(Offset.X, 0, Offset.Z).Magnitude
        local HorizontalDirection = Vector3.new(SolvedDirection.X, 0, SolvedDirection.Z)
        local HorizontalSpeed = HorizontalDirection.Magnitude * Speed
        local NewTravelTime

        if HorizontalSpeed > 0.001 then
            NewTravelTime = HorizontalDistance / HorizontalSpeed
        else
            NewTravelTime = Offset.Magnitude / math.max(Speed, 1)
        end

        NewTravelTime = math.clamp(NewTravelTime, 0, 4)
        if math.abs(NewTravelTime - TravelTime) <= 0.0005 then
            TravelTime = NewTravelTime
            break
        end
        TravelTime = TravelTime + (NewTravelTime - TravelTime) * 0.75
    end

    if not SolvedDirection then
        return Direction
    end

    PredictedPosition = HeadPosition + Velocity * (TravelTime + PingCompensation)
    local Success, Result = pcall(BowSilentNativeSolveLaunchDirection, Origin, PredictedPosition, Speed, Gravity)
    if Success and typeof(Result) == "Vector3" and Result.Magnitude >= 0.001 then
        SolvedDirection = Result.Unit
    end

    BowSilentVisualRuntime.Target = Target
    BowSilentVisualRuntime.TargetName = Target.Name
    BowSilentVisualRuntime.TargetPart = Head
    BowSilentVisualRuntime.TargetPartName = "Head"
    BowSilentVisualRuntime.PredictionTime = TravelTime
    BowSilentVisualRuntime.PingCompensation = PingCompensation
    BowSilentVisualRuntime.PredictedPosition = PredictedPosition
    if CountRedirect ~= false then
        BowSilentVisualRuntime.Redirects += 1
    end

    return SolvedDirection
end

local function BowSilentLocalOrigin(Origin)
    if typeof(Origin) ~= "Vector3" then
        return false
    end
    local Character = BowSilentLocalPlayer and BowSilentLocalPlayer.Character
    local Root = Character and (Character:FindFirstChild("HumanoidRootPart") or Character.PrimaryPart)
    if not Root or not Root:IsA("BasePart") then
        return false
    end
    return (Origin - Root.Position).Magnitude <= 18
end

if type(BowSilentNativeSolveLaunchDirection) == "function" and type(BowSilentBowConfig) == "table" then
    local function BowSilentSolverWrapper(Origin, TargetPosition, Force, Gravity)
        local Original = BowSilentSolverState.Original
        if type(Original) ~= "function" then
            return typeof(TargetPosition) == "Vector3" and (TargetPosition - Origin).Unit or Vector3.new(0, 0, -1)
        end

        local NativeDirection = Original(Origin, TargetPosition, Force, Gravity)
        if BowSilentFlag("BowSilentEnabled") == true and BowSilentLocalOrigin(Origin) then
            local Redirected = BowSilentRedirectDirection(Origin, NativeDirection, Force, true, Gravity)
            if typeof(Redirected) == "Vector3" and Redirected.Magnitude >= 0.001 then
                return Redirected.Unit
            end
        end
        return NativeDirection
    end

    BowSilentSolverState.Wrapper = BowSilentSolverWrapper
    local Success = pcall(function()
        BowSilentBowConfig.SolveLaunchDirection = BowSilentSolverWrapper
    end)
    BowSilentSolverState.Installed = Success and BowSilentBowConfig.SolveLaunchDirection == BowSilentSolverWrapper
end

