    Lines[#Lines + 1] = "ControlsCached: " .. tostring(Controls)
    Lines[#Lines + 1] = "Flags: " .. tostring(Flags)
    Lines[#Lines + 1] = "Keybinds: " .. tostring(Keybinds)
    Lines[#Lines + 1] = "ConfigButtonsScanned: " .. tostring(ConfigButtons)
    Lines[#Lines + 1] = "InstanceScan: disabled for executor compatibility"

    return table.concat(Lines, "\n")
end

Debug:Button({
    Name = "Refresh UI debug",
    Icon = "refresh-cw",
    Callback = function()
        RefreshUIDebug()
    end
})

Debug:Button({
    Name = "Save UI debug",
    Icon = "save",
    Callback = function()
        if typeof(writefile) ~= "function" then
            return
        end
        local Path = CreateUniqueDebugFile("ui-debug")
        if not Path then
            return
        end
        pcall(writefile, Path, BuildUIDebug())
    end
})
