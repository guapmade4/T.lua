local function ReadMainFlag(Name)
    local Control = Library.Flags and Library.Flags[Name]
    if not Control or type(Control.Get) ~= "function" then
        return nil
    end

    local Success, Value = pcall(function()
        return Control:Get()
    end)

    if Success then
        return Value
    end

    return nil
end

local function ReadAccuracyRange()
    local Value = ReadMainFlag("AccuracyRange")

    if type(Value) == "table" then
        local Min = tonumber(Value.Min or Value.min or Value[1]) or 0
        local Max = tonumber(Value.Max or Value.max or Value[2]) or 100
        return Min, Max
    end

    return 0, 100
end

