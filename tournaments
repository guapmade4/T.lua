        AutoParryCombat = Remote
        if Remote and Remote:IsA("RemoteEvent") then
            local Connection = Remote.OnClientEvent:Connect(function(Action)
                if Action == "ParryCD" then
                    AutoParryRuntime.ParryReadyAt = 0
                    AutoParryRuntime.Note("Parry cooldown reset", "Observed game event")
                end
            end)
            AutoParryRuntime.CooldownConnection = Connection
            AutoParryRuntime.Connections[#AutoParryRuntime.Connections + 1] = Connection
        end
    end
    if not AutoParryWeapons or not AutoParryWeapons.Parent then
        pcall(function()
            AutoParryWeapons = AutoParryReplicatedStorage.Assets.Animations.Weapons
        end)
    end
    if type(AutoParryWeaponStats) ~= "table" and not AutoParryRuntime.ResolvingStats then
        local Modules = AutoParryReplicatedStorage:FindFirstChild("Modules")
        local Module = Modules and Modules:FindFirstChild("WeaponStats")
        if not Module then
            AutoParryRuntime.StatsError = "WeaponStats module unavailable"
            return
        end
        AutoParryRuntime.ResolvingStats = true
        local Success, Result = pcall(require, Module)
        AutoParryRuntime.ResolvingStats = false
        if Success and type(Result) == "table" and type(Result.getStats) == "function" then
            AutoParryWeaponStats = Result
            AutoParryRuntime.StatsError = "none"
            AutoParryRuntime.Note("WeaponStats ready", "Loaded game weapon data")
        else
            AutoParryRuntime.StatsError = tostring(Success and "WeaponStats.getStats unavailable" or Result):sub(1, 500)
        end
    end
end

