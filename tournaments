local function ArrowVisualRearPosition(Tracker, Fallback)
    local Trail = Tracker.GameTrail or ArrowVisualGameTrail(Tracker.Object)
    if Trail then
        Tracker.GameTrail = Trail
        local P0 = nil
        local P1 = nil
        pcall(function() if Trail.Attachment0 and Trail.Attachment0.Parent then P0 = Trail.Attachment0.WorldPosition end end)
        pcall(function() if Trail.Attachment1 and Trail.Attachment1.Parent then P1 = Trail.Attachment1.WorldPosition end end)
        if typeof(P0) == "Vector3" and typeof(P1) == "Vector3" then
            local Direction = Tracker.LastDirection
            if typeof(Direction) ~= "Vector3" or Direction.Magnitude <= 0.001 then
                local Success, Velocity = pcall(function() return Tracker.Part.AssemblyLinearVelocity end)
                if Success and typeof(Velocity) == "Vector3" and Velocity.Magnitude > 0.001 then Direction = Velocity.Unit end
            end
            if typeof(Direction) == "Vector3" and Direction.Magnitude > 0.001 then
                Direction = Direction.Unit
                local Pivot = Tracker.Part and Tracker.Part.Position or ((P0 + P1) * 0.5)
                local D0 = (P0 - Pivot):Dot(Direction)
                local D1 = (P1 - Pivot):Dot(Direction)
                return D0 <= D1 and P0 or P1
            end
            return (P0 + P1) * 0.5
        end
        if typeof(P0) == "Vector3" then return P0 end
        if typeof(P1) == "Vector3" then return P1 end
    end
    return Fallback
end

