    return true
end

local function BowSilentRadius(Camera)
    local Viewport = Camera.ViewportSize
    local Center = Vector2.new(Viewport.X * 0.5, Viewport.Y * 0.5)
    local RadiusSetting = tonumber(BowSilentFlag("BowSilentFOVRadius")) or 35
    local CurrentFOV = tonumber(Camera.FieldOfView) or BowSilentDefaultFOV
    local Radius = RadiusSetting * 5 * (CurrentFOV / math.max(1, BowSilentDefaultFOV))
    return Center, Radius
end

local function BowSilentTarget(Camera, Center, Radius)
    local Best = nil
    local BestScreen = nil
    local BestHead = nil
    local BestDistance = Radius
    for _, Player in ipairs(BowSilentPlayers:GetPlayers()) do
        if Player ~= BowSilentLocalPlayer then
            local Character = Player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
            local Head = Character and Character:FindFirstChild("Head")
            if Humanoid and Humanoid.Health > 0 and Head and Head:IsA("BasePart") then
                local Projected, OnScreen = Camera:WorldToViewportPoint(Head.Position)
                if OnScreen and Projected.Z > 0 then
                    local Screen = Vector2.new(Projected.X, Projected.Y)
                    local Distance = (Screen - Center).Magnitude
                    if Distance <= BestDistance then
                        BestDistance = Distance
                        Best = Player
                        BestScreen = Screen
                        BestHead = Head
                    end
                end
            end
        end
    end
    return Best, BestScreen, BestHead
end

local function BowSilentAcquireTarget()
    local Camera = BowSilentWorkspace.CurrentCamera
    if not Camera then
        return nil
    end
    local Center, Radius = BowSilentRadius(Camera)
    local Target, Screen, Head = BowSilentTarget(Camera, Center, Radius)
    return Target, Head, Screen, Center, Radius
end

local function BowSilentPingCompensation()
    local Milliseconds = 0
    pcall(function()
        local Item = BowSilentStats.Network.ServerStatsItem["Data Ping"]
        if Item then
            Milliseconds = tonumber(Item:GetValue()) or 0
        end
    end)
    return math.clamp(Milliseconds / 2000, 0, 0.25)
end

local function BowSilentVelocity(Target, Head)
    local Character = Target and Target.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Velocity = Vector3.zero
    if Root and Root:IsA("BasePart") then
        Velocity = Root.AssemblyLinearVelocity
    elseif Head and Head:IsA("BasePart") then
        Velocity = Head.AssemblyLinearVelocity
    end
    if typeof(Velocity) ~= "Vector3" then
        return Vector3.zero
    end
    return Velocity
end

