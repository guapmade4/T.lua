    function Tracker.Cleanup()
        if Tracker.Cleaned then
            return
        end
        Tracker.Cleaned = true
        ArrowVisualDestroyTracer(Tracker, true)
        ArrowVisualRuntime.Trackers[Object] = nil
        ArrowVisualRuntime.ActiveArrows = math.max(0, ArrowVisualRuntime.ActiveArrows - 1)
    end

    ArrowVisualRuntime.Trackers[Object] = Tracker
    ArrowVisualRuntime.LocalArrows += 1
    ArrowVisualRuntime.ActiveArrows += 1
end

