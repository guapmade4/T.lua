    local function SendExit(Trigger, Detail)
        if not State.Active or State.Exit then
            return
        end
        local Exit = {Trigger = Trigger, Detail = Detail, Sent = false}
        State.Exit = Exit
        State.LastTrigger = Trigger
        State.LastStatus = "Preparing"
        local Snapshot = CaptureSnapshot()
        if Snapshot == "" then
            Finish(Exit, false, "Snapshot unavailable", 0)
