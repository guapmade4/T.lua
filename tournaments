local ArrowVisualRender = ArrowVisualRunService.RenderStepped:Connect(function()
    local TracerEnabled = ArrowVisualFlag("ArrowTracerEnabled", false) == true
    local Style = "Squiggle"
    ArrowVisualRuntime.LastTracerType = "Squiggle"

    for Object, Tracker in pairs(ArrowVisualRuntime.Trackers) do
        if not Object.Parent or not Tracker.Part or not Tracker.Part.Parent then
            Tracker.Cleanup()
            continue
        end

        local Position = Tracker.Part.Position
        local Delta = Position - Tracker.LastPosition
        if Delta.Magnitude > 0.02 then
            Tracker.Moved = true
            Tracker.LastDirection = Delta.Unit
        end

        local GameTrail = ArrowVisualGameTrail(Object)
        local GameTrailEnabled = GameTrail and GameTrail.Enabled == true or false
        local RearPosition = ArrowVisualRearPosition(Tracker, Position)
        if Tracker.LastGameTrailEnabled == nil then
            Tracker.LastGameTrailEnabled = GameTrailEnabled
        elseif Tracker.LastGameTrailEnabled and not GameTrailEnabled and Tracker.Moved then
            ArrowVisualCreateImpact(Tracker, Position)
        end
        Tracker.LastGameTrailEnabled = GameTrailEnabled

        if TracerEnabled and not Tracker.ImpactDone then
            if Tracker.TracerStyle ~= Style then
                ArrowVisualDestroyTracer(Tracker, true)
                Tracker.Cleaned = false
                if ArrowVisualApplyGameTrailTracer(Tracker) then ArrowVisualRuntime.Tracers += 1 end
            else
                ArrowVisualApplyGameTrailTracer(Tracker)
            end
        elseif not Tracker.ImpactDone then
            ArrowVisualDestroyTracer(Tracker, true)
            Tracker.Cleaned = false
        end

        Tracker.LastPosition = Position
    end
end)

